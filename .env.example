# Configuracoes Principais - TaskForge
APP_NAME=TaskForge
APP_ENV=production
PORT=8000
TZ=America/Sao_Paulo

# Seguranca e Autenticacao
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@taskforge.local
DEFAULT_ADMIN_PASSWORD=Admin@123456
WEBHOOK_RECEIVER_TOKEN=wh_sec_token_change_me

# Armazenamento e Banco de Dados (Volumes Persistentes no Docker)
DATA_DIR=/app/data
DB_PATH=/app/data/tasks.db
EXECUTIONS_DB_PATH=/app/data/executions.db
ATTACHMENTS_DIR=/app/data/attachments
BACKUPS_DIR=/app/data/backups
BACKUP_RETENTION_COUNT=10
AUTO_BACKUP_CRON=0 3 * * *

# Web Push VAPID (Gerado automaticamente em /app/data/vapid.json se vazio)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@taskforge.local
